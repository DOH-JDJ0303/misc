flowchart LR
    %% Main workflow for ONT-only with Flye

    %% Input outside the core workflow
    A[ONT Reads]

    subgraph Donut_Falls_Core_Workflow[Donut_Falls Core Workflow]
        B[Quality Control: fastplong + rasusa]
        C[Flye Assembly]
        D[Assembly Stats: gfastats + bandage]
        E[Reorient Contigs: dnaapler]
        F[Coverage Analysis: circulocov]
        G[Variant Calling: clair3]
        H[Apply Variants: bcftools]
        I[Quality Assessment: busco]
        J[Final Summary: summary + multiqc]

        %% Internal flow
        B --> C --> D --> E --> F --> G --> H --> I --> J
    

    %% Connections from outside
    A --> B

    %% Parallel processes
    A --> K[Read Statistics: seqkit]
    K --> J
    E --> M[Completeness Check: busco]
    M --> J

    %% Styling
    classDef main fill:#e8f5e8,stroke:#2e7d32,stroke-width:3px
    classDef parallel fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef summary fill:#fff3e0,stroke:#ef6c00,stroke-width:2px

    class B,C,D,E,F,G,H,I main
    class K,M parallel
    class J summary
    end

    subgraph WAPHL_Analysis[WAPHL Analysis]
    J --> final_summary["Final Summary"]
    mash_taxa[MASH_TAXA]

        %%     B1[Select best consensus fasta\n(priority: pypolca > polypolish > clair3 > reoriented > unicycler)]
